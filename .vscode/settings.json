{
  "python.defaultInterpreterPath": "${workspaceFolder}/src/venv/bin/python",
  "python.languageServer": "Pylance",
  "[python]": {
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "on"
    },
    "editor.suggestOnTriggerCharacters": true,
    "editor.parameterHints.enabled": true
  }
}
